<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules">
  <Style TargetType="{x:Type molecules:AnnotatedText}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type molecules:AnnotatedText}">
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Text}" />

            <TextBlock
              x:Name="secondaryTextBlock"
              Margin="4,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{TemplateBinding SecondaryText}"
              Visibility="Collapsed" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="IsSecondaryTextVisible" Value="True">
              <Setter TargetName="secondaryTextBlock" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
