<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:primitives="clr-namespace:Quaply.Ui.Views.Molecules.Primitives">
  <Style TargetType="{x:Type primitives:ValidatedField}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type primitives:ValidatedField}">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{TemplateBinding Label}" />

              <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="12"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Text="{TemplateBinding ErrorText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            </Grid>

            <ContentPresenter Content="{TemplateBinding Content}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
