<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules">
  <Style TargetType="{x:Type molecules:EmptyState}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type molecules:EmptyState}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <ContentPresenter
              x:Name="iconPresenter"
              Margin="0,0,0,12"
              HorizontalAlignment="Center"
              Content="{TemplateBinding Icon}"
              TextElement.FontSize="48"
              TextElement.Foreground="{DynamicResource TextFillColorDisabledBrush}" />

            <TextBlock
              HorizontalAlignment="Center"
              FontSize="16"
              FontWeight="SemiBold"
              Text="{TemplateBinding Title}" />

            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{TemplateBinding Description}" />

            <ContentPresenter
              x:Name="actionsPresenter"
              Margin="0,16,0,0"
              HorizontalAlignment="Center"
              Content="{TemplateBinding Actions}" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <!--  No icon provided: remove the icon area and its spacing  -->
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  No actions provided: remove the action area and its spacing  -->
            <Trigger Property="Actions" Value="{x:Null}">
              <Setter TargetName="actionsPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  Actions provided, but the consumer collapsed it (e.g. a single button)  -->
            <DataTrigger Binding="{Binding Actions.Visibility, RelativeSource={RelativeSource Self}}" Value="Collapsed">
              <Setter TargetName="actionsPresenter" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
