<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Style TargetType="{x:Type molecules:PageNavigationBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type molecules:PageNavigationBar}">
          <Grid ColumnDefinitions="Auto,*">
            <Border
              Grid.Column="0"
              BorderBrush="{DynamicResource ControlElevationBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              UseLayoutRounding="True">
              <StackPanel Orientation="Horizontal">
                <ui:Button
                  x:Name="goBackButton"
                  BorderThickness="0"
                  Command="{TemplateBinding GoBackCommand}"
                  CornerRadius="4,0,0,4"
                  Icon="{ui:SymbolIcon ArrowLeft16}"
                  Style="{DynamicResource IconOnlyButtonStyle}"
                  ToolTip="{TemplateBinding GoBackToolTip}" />

                <Border Width="1" Background="{DynamicResource ControlElevationBorderBrush}" />

                <ui:Button
                  x:Name="goForwardButton"
                  BorderThickness="0"
                  Command="{TemplateBinding GoForwardCommand}"
                  CornerRadius="0,4,4,0"
                  Icon="{ui:SymbolIcon ArrowRight16}"
                  Style="{DynamicResource IconOnlyButtonStyle}"
                  ToolTip="{TemplateBinding GoForwardToolTip}" />
              </StackPanel>
            </Border>

            <!--  TODO: implement Breadcrumb's logic.  -->
            <ui:BreadcrumbBar
              Grid.Column="1"
              Margin="16,0,0,0"
              VerticalAlignment="Center"
              FontSize="20" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="GoBackCommand" Value="{x:Null}">
              <Setter TargetName="goBackButton" Property="IsEnabled" Value="False" />
            </Trigger>

            <Trigger Property="GoForwardCommand" Value="{x:Null}">
              <Setter TargetName="goForwardButton" Property="IsEnabled" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
