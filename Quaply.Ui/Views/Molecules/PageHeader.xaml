<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules">
  <Style TargetType="{x:Type molecules:PageHeader}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type molecules:PageHeader}">
          <StackPanel>
            <TextBlock
              FontSize="22"
              FontWeight="SemiBold"
              Text="{TemplateBinding Title}" />

            <TextBlock
              x:Name="subtitleText"
              Margin="0,4,0,0"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{TemplateBinding Subtitle}"
              TextWrapping="Wrap" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <!--  Hide when there is no subtitle  -->
            <Trigger Property="Subtitle" Value="">
              <Setter TargetName="subtitleText" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="Subtitle" Value="{x:Null}">
              <Setter TargetName="subtitleText" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
