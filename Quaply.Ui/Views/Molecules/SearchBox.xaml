<UserControl
  x:Class="Quaply.Ui.Views.Molecules.SearchBox"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:Quaply.Ui.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  x:Name="searchBox"
  d:Width="320"
  mc:Ignorable="d">
  <Grid>
    <ui:TextBox
      x:Name="innerTextBox"
      Icon="{ui:SymbolIcon Search24}"
      PlaceholderText="{Binding PlaceholderText, ElementName=searchBox}"
      Text="{Binding Text, ElementName=searchBox, UpdateSourceTrigger=PropertyChanged}" />

    <ui:ProgressRing
      Width="{Binding ProgressRingSize, ElementName=searchBox}"
      Height="{Binding ProgressRingSize, ElementName=searchBox}"
      Margin="0,0,32,-1"
      HorizontalAlignment="Right"
      VerticalAlignment="Center"
      d:Height="20"
      d:Width="20"
      IsIndeterminate="True"
      Visibility="{Binding IsBusy, ElementName=searchBox, Converter={converters:BooleanToVisibilityConverter}}" />
  </Grid>
</UserControl>
