<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Style TargetType="{x:Type molecules:Pager}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type molecules:Pager}">
          <StackPanel Orientation="Horizontal">
            <TextBlock
              MinWidth="72"
              Margin="0,0,16,0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Text="{TemplateBinding Text}" />

            <ui:Button
              Margin="0,0,8,0"
              Command="{TemplateBinding PreviousCommand}"
              Icon="{ui:SymbolIcon ChevronLeft16}"
              Style="{DynamicResource IconOnlyButtonStyle}"
              ToolTip="{TemplateBinding PreviousToolTip}" />

            <ui:Button
              Command="{TemplateBinding NextCommand}"
              Icon="{ui:SymbolIcon ChevronRight16}"
              Style="{DynamicResource IconOnlyButtonStyle}"
              ToolTip="{TemplateBinding NextToolTip}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
