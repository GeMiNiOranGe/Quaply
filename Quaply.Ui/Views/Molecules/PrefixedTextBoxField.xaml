<UserControl
  x:Class="Quaply.Ui.Views.Molecules.PrefixedTextBoxField"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  x:Name="prefixedTextBoxField"
  d:DesignWidth="300"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style
      x:Key="InputTextBoxStyle"
      BasedOn="{StaticResource {x:Type ui:TextBox}}"
      TargetType="ui:TextBox">
      <Setter Property="Border.CornerRadius" Value="0,4,4,0" />
      <Setter Property="BorderThickness" Value="0,1,1,1" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Margin="0,0,0,4" Text="{Binding Label, ElementName=prefixedTextBoxField}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="PrefixColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        Background="{DynamicResource ControlFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,1"
        CornerRadius="4,0,0,4">
        <TextBlock
          Padding="12,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding Prefix, ElementName=prefixedTextBoxField}" />
      </Border>

      <ui:TextBox
        Grid.Column="1"
        PlaceholderText="{Binding PlaceholderText, ElementName=prefixedTextBoxField}"
        Style="{StaticResource InputTextBoxStyle}"
        Text="{Binding Text, ElementName=prefixedTextBoxField, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
  </StackPanel>
</UserControl>
