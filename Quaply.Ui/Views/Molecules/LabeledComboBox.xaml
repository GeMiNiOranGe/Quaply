<UserControl
  x:Class="Quaply.Ui.Views.Molecules.LabeledComboBox"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  x:Name="labeledComboBox"
  mc:Ignorable="d">
  <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
    <TextBlock
      Margin="0,0,8,0"
      VerticalAlignment="Center"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      Text="{Binding Label, ElementName=labeledComboBox}" />

    <ComboBox
      MinWidth="72"
      Padding="8,6"
      Background="Transparent"
      ItemsSource="{Binding ItemsSource, ElementName=labeledComboBox}"
      SelectedItem="{Binding SelectedItem, ElementName=labeledComboBox, Mode=TwoWay}" />
  </StackPanel>
</UserControl>
