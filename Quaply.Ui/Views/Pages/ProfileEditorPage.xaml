<UserControl
  x:Class="Quaply.Ui.Views.Pages.ProfileEditorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Page header  -->
    <StackPanel Grid.Row="0" Margin="24,16,24,8">
      <TextBlock
        FontSize="22"
        FontWeight="SemiBold"
        Text="{Binding PageTitle}" />
      <TextBlock
        Margin="0,4,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="This information will appear at the top of your Resume." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <!--  Form card  -->
      <ui:Card Margin="24,0,24,16" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="24">
            <!--  Section: Basic info  -->
            <TextBlock
              Margin="0,0,0,8"
              FontSize="20"
              FontWeight="SemiBold"
              Text="Personal information" />

            <Separator Margin="0,0,0,8" />

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="Full Name *" />

                  <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=fullNameTextBox}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                </Grid>

                <ui:TextBox
                  x:Name="fullNameTextBox"
                  PlaceholderText="John Doe"
                  Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4" Text="Title" />
                <ui:TextBox PlaceholderText="Software Engineer" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="Email Address" />

                  <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=emailTextBox}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                </Grid>

                <ui:TextBox
                  x:Name="emailTextBox"
                  Icon="{ui:SymbolIcon Mail24}"
                  PlaceholderText="john.doe@example.com"
                  Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="Phone Number" />

                  <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=phoneNumberTextBox}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                </Grid>

                <ui:TextBox
                  x:Name="phoneNumberTextBox"
                  Icon="{ui:SymbolIcon Call24}"
                  PlaceholderText="+1 555 123 4567"
                  Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Column="0" Margin="0,0,0,16">
              <TextBlock Margin="0,0,0,4" Text="Date of Birth" />

              <DatePicker SelectedDate="{Binding DateOfBirth, Converter={StaticResource DateOnlyToDateTimeConverter}}" />
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
              <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Social media links" />

              <Separator Margin="0,0,0,8" />

              <!--  LinkedIn  -->
              <StackPanel Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="LinkedIn" />

                <Grid Height="38">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PrefixColumn" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border
                    Grid.Column="0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,1"
                    CornerRadius="4,0,0,4">
                    <TextBlock
                      Margin="12,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="https://linkedin.com/in/" />
                  </Border>

                  <ui:TextBox
                    Grid.Column="1"
                    PlaceholderText="john-doe"
                    Text="{Binding LinkedInUsername, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </StackPanel>

              <!--  GitHub  -->
              <StackPanel Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="GitHub" />

                <Grid Height="38">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PrefixColumn" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border
                    Grid.Column="0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,1"
                    CornerRadius="4,0,0,4">
                    <TextBlock
                      Margin="12,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="https://github.com/" />
                  </Border>

                  <ui:TextBox
                    Grid.Column="1"
                    PlaceholderText="JohnDoe"
                    Text="{Binding GitHubUsername, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </StackPanel>

              <!--  Portfolio  -->
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="Portfolio" />

                  <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=portfolioUrlTextBox}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                </Grid>

                <ui:TextBox
                  x:Name="portfolioUrlTextBox"
                  Grid.Column="1"
                  PlaceholderText="https://johndoe.com"
                  Text="{Binding PortfolioUrl, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!--  Footer actions  -->
          <Border
            Grid.Row="1"
            Padding="24,16"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button
                Padding="16,8"
                Command="{Binding CancelCommand}"
                Content="Cancel" />

              <ui:Button
                Margin="8,0,0,0"
                Padding="16,8"
                Appearance="Primary"
                Command="{Binding SaveCommand}"
                Content="Save"
                Icon="{ui:SymbolIcon Save24}" />
            </StackPanel>
          </Border>
        </Grid>
      </ui:Card>
    </ScrollViewer>
  </Grid>
</UserControl>
