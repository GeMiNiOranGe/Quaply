<UserControl
  x:Class="Quaply.Ui.Views.Pages.WorkExperienceEditorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:Quaply.Ui.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:layout="clr-namespace:Quaply.Ui.AttachedProperties"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:viewModels="clr-namespace:Quaply.Ui.ViewModels"
  d:DataContext="{d:DesignInstance Type=viewModels:WorkExperienceEditorViewModel,
                                   IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Page header  -->
    <StackPanel
      Grid.Row="0"
      MaxWidth="{StaticResource PageMaxWidthForm}"
      Margin="24,16,24,8"
      HorizontalAlignment="Stretch">
      <TextBlock
        FontSize="22"
        FontWeight="SemiBold"
        Text="{Binding PageTitle}" />
      <TextBlock
        Margin="0,4,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Add roles and responsibilities you want to highlight on your Resume." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <!--  Form card  -->
      <ui:Card
        MaxWidth="{StaticResource PageMaxWidthForm}"
        Margin="24,0,24,16"
        Padding="0"
        HorizontalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel
            Grid.Row="0"
            Margin="24"
            layout:Gap.Vertical="24">
            <StackPanel layout:Gap.Vertical="16">
              <!--  Section: Role info  -->
              <StackPanel>
                <TextBlock
                  Margin="0,0,0,8"
                  FontSize="20"
                  FontWeight="SemiBold"
                  Text="Role information" />

                <Separator />
              </StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <molecules:ValidatedTextBoxField
                  Grid.Column="0"
                  Label="Company Name *"
                  PlaceholderText="Acme Corp"
                  Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />

                <molecules:ValidatedTextBoxField
                  Grid.Column="2"
                  Label="Position Title"
                  PlaceholderText="Software Engineer"
                  Text="{Binding PositionTitle, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
              </Grid>
            </StackPanel>

            <StackPanel layout:Gap.Vertical="16">
              <!--  Section: Timeline  -->
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Timeline" />

                  <ui:Badge
                    Grid.Column="1"
                    Padding="8,4"
                    VerticalAlignment="Bottom"
                    Appearance="Secondary"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding DurationPreview, Converter={converters:NullToVisibilityConverter}}">
                    <TextBlock FontSize="12" Text="{Binding DurationPreview}" />
                  </ui:Badge>
                </Grid>

                <Separator />
              </StackPanel>

              <CheckBox
                Padding="0"
                Content="I am currently working here"
                IsChecked="{Binding IsCurrentlyWorking}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <molecules:ValidatedDatePickerField
                  Grid.Column="0"
                  Label="Start Date"
                  SelectedDate="{Binding StartDate, Converter={converters:DateOnlyToDateTimeConverter}, NotifyOnValidationError=True}" />

                <molecules:ValidatedDatePickerField
                  Grid.Column="2"
                  IsValueEditable="{Binding CanEditEndDate}"
                  Label="End Date"
                  SelectedDate="{Binding EndDate, Converter={converters:DateOnlyToDateTimeConverter}, NotifyOnValidationError=True}" />
              </Grid>
            </StackPanel>

            <StackPanel layout:Gap.Vertical="16">
              <!--  Section: Description  -->
              <StackPanel>
                <TextBlock
                  Margin="0,0,0,8"
                  FontSize="20"
                  FontWeight="SemiBold"
                  Text="Description" />

                <Separator />
              </StackPanel>

              <StackPanel>
                <molecules:ValidatedTextBoxField
                  AcceptsReturn="True"
                  Label="Responsibilities &amp; Achievements"
                  MaxLines="8"
                  MinLines="4"
                  PlaceholderText="Led a team of 4 engineers to redesign the checkout flow, reducing cart abandonment by 15%..."
                  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                  TextWrapping="Wrap" />

                <TextBlock
                  Margin="0,4,0,0"
                  HorizontalAlignment="Right"
                  FontSize="12"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding DescriptionCharacterCount, StringFormat='{}{0} / 1000'}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!--  Footer actions  -->
          <Border
            Grid.Row="1"
            Padding="24,16"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ui:Button
                Grid.Column="0"
                Padding="16,8"
                HorizontalAlignment="Left"
                Appearance="Transparent"
                Command="{Binding ResetCommand}"
                Content="{Binding ResetButtonText}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="{Binding ResetButtonIcon}" />
                </ui:Button.Icon>
              </ui:Button>

              <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                  Padding="16,8"
                  Command="{Binding CancelCommand}"
                  Content="Cancel" />

                <ui:Button
                  Margin="8,0,0,0"
                  Padding="16,8"
                  Appearance="Primary"
                  Command="{Binding SaveCommand}"
                  Content="{Binding SaveButtonText}"
                  Icon="{ui:SymbolIcon Save24}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </ui:Card>
    </ScrollViewer>
  </Grid>
</UserControl>
