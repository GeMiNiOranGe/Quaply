<UserControl
  x:Class="Quaply.Ui.Views.Pages.ProfileTrashPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:Quaply.Ui.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:viewModels="clr-namespace:Quaply.Ui.ViewModels"
  x:Name="profileTrashPage"
  d:DataContext="{d:DesignInstance Type=viewModels:ProfileTrashViewModel,
                                   IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">
  <Grid Margin="24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Top actions  -->
    <StackPanel
      Grid.Row="0"
      Margin="0,0,0,8"
      Orientation="Horizontal">
      <ui:Button
        Padding="8"
        Command="{Binding BackToProfilesCommand}"
        Content="Back to Profiles"
        Icon="{ui:SymbolIcon ArrowLeft24}" />
    </StackPanel>

    <!--  List  -->
    <ui:Card
      Grid.Row="1"
      Padding="0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
          Grid.Row="0"
          Padding="24,16"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
              VerticalAlignment="Center"
              FontSize="18"
              FontWeight="SemiBold"
              Text="Deleted Profiles" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button
                Margin="0,0,8,0"
                Padding="8"
                Appearance="Transparent"
                ToolTip="Filter">
                <ui:SymbolIcon Symbol="Filter24" />
              </ui:Button>

              <ui:Button
                Padding="8"
                Appearance="Transparent"
                ToolTip="More">
                <ui:SymbolIcon Symbol="MoreVertical24" />
              </ui:Button>
            </StackPanel>
          </Grid>
        </Border>

        <!--  Table  -->
        <DataGrid
          Grid.Row="1"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          HeadersVisibility="Column"
          IsReadOnly="True"
          ItemsSource="{Binding DeletedProfiles}"
          RowHeight="48"
          SelectedItem="{Binding SelectedProfile}"
          SelectionMode="Extended">
          <DataGrid.Columns>
            <!--  Checkbox  -->
            <DataGridTemplateColumn Width="64">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--  Full Name  -->
            <DataGridTextColumn
              Width="180"
              Binding="{Binding FullName}"
              Header="Full Name" />

            <!--  Email  -->
            <DataGridTextColumn
              Width="224"
              Binding="{Binding Email}"
              Header="Email" />

            <!--  Deleted At  -->
            <DataGridTextColumn Width="170" Header="Deleted On">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding DeletedAt, Converter={converters:RelativeDateTimeConverter}}" />
                  <Setter Property="ToolTip">
                    <Setter.Value>
                      <ToolTip MaxWidth="{x:Static system:Double.PositiveInfinity}">
                        <TextBlock Text="{Binding DeletedAt, Converter={converters:FullLocalDateTimeConverter}}" TextWrapping="NoWrap" />
                      </ToolTip>
                    </Setter.Value>
                  </Setter>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!--  Actions  -->
            <DataGridTemplateColumn Width="96" Header="Actions">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                      Margin="0,0,8,0"
                      Padding="8"
                      Appearance="Transparent"
                      Command="{Binding DataContext.RestoreProfileCommand, ElementName=profileTrashPage}"
                      CommandParameter="{Binding}"
                      ToolTip="Restore">
                      <ui:SymbolIcon Symbol="ArrowUndo24" />
                    </ui:Button>

                    <ui:Button
                      Padding="8"
                      Appearance="Transparent"
                      Command="{Binding DataContext.PurgeProfileCommand, ElementName=profileTrashPage}"
                      CommandParameter="{Binding}"
                      ToolTip="Delete Permanently">
                      <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                    </ui:Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </ui:Card>
  </Grid>
</UserControl>
