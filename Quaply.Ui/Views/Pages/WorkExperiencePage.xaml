<UserControl
  x:Class="Quaply.Ui.Views.Pages.WorkExperiencePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewModels="clr-namespace:Quaply.Ui.ViewModels"
  d:DataContext="{d:DesignInstance Type=viewModels:WorkExperienceViewModel,
                                   IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">
  <Grid>
    <TextBlock
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      FontSize="24"
      FontWeight="Bold"
      Text="Work experience page" />
    <Button
      Padding="8"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Command="{Binding NavigateToProfileCommand}"
      Content="Go to Profile page" />
  </Grid>
</UserControl>
