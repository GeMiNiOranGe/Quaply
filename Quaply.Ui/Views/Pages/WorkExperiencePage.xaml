<UserControl
  x:Class="Quaply.Ui.Views.Pages.WorkExperiencePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:atoms="clr-namespace:Quaply.Ui.Views.Atoms"
  xmlns:converters="clr-namespace:Quaply.Ui.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:layout="clr-namespace:Quaply.Ui.AttachedProperties"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:markup="clr-namespace:Quaply.Ui.MarkupHelpers"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:queryingBase="clr-namespace:Quaply.Data.Querying.Base;assembly=Quaply.Data"
  xmlns:queryingWorkExperiences="clr-namespace:Quaply.Data.Querying.WorkExperiences;assembly=Quaply.Data"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:viewModels="clr-namespace:Quaply.Ui.ViewModels"
  x:Name="workExperiencePage"
  d:DataContext="{d:DesignInstance Type=viewModels:WorkExperienceViewModel,
                                   IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <markup:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

    <ContextMenu
      x:Key="UpdatedRangeMenu"
      x:Shared="False"
      ItemsSource="{markup:EnumBindingSource {x:Type queryingBase:RelativeDateRange}}"
      Placement="Bottom">
      <ContextMenu.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
          <Setter Property="Command" Value="{Binding DataContext.SetUpdatedRangeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

          <Setter Property="CommandParameter" Value="{Binding}" />

          <Setter Property="Header" Value="{Binding Converter={converters:EnumDisplayNameConverter}}" />

          <Setter Property="IsCheckable" Value="True" />

          <Setter Property="IsChecked">
            <Setter.Value>
              <MultiBinding Converter="{converters:EnumEqualityConverter}" Mode="OneWay">
                <Binding Path="DataContext.SelectedUpdatedRange" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />

                <Binding />
              </MultiBinding>
            </Setter.Value>
          </Setter>
        </Style>
      </ContextMenu.ItemContainerStyle>
    </ContextMenu>

    <ContextMenu
      x:Key="SortFieldMenu"
      x:Shared="False"
      ItemsSource="{markup:EnumBindingSource {x:Type queryingWorkExperiences:WorkExperienceSortField}}"
      Placement="Bottom">
      <ContextMenu.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
          <Setter Property="Command" Value="{Binding DataContext.SetSortFieldCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

          <Setter Property="CommandParameter" Value="{Binding}" />

          <Setter Property="Header" Value="{Binding Converter={converters:EnumDisplayNameConverter}}" />

          <Setter Property="IsCheckable" Value="True" />

          <Setter Property="IsChecked">
            <Setter.Value>
              <MultiBinding Converter="{converters:EnumEqualityConverter}" Mode="OneWay">
                <Binding Path="DataContext.SortField" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />

                <Binding />
              </MultiBinding>
            </Setter.Value>
          </Setter>
        </Style>
      </ContextMenu.ItemContainerStyle>
    </ContextMenu>
  </UserControl.Resources>

  <Grid MaxWidth="{StaticResource PageMaxWidthTable}" Margin="24,16,24,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  Navigation and Page Header  -->
    <StackPanel Grid.Row="0" Margin="0,0,0,24">
      <StackPanel Margin="0,0,0,8">
        <TextBlock
          FontSize="22"
          FontWeight="SemiBold"
          Text="Work Experiences" />

        <TextBlock
          Margin="0,4,0,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="Select the experiences that best match the job you're applying for." />
      </StackPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <ui:Button
            Command="{Binding NavigateToProfileCommand}"
            CornerRadius="4,0,0,4"
            Icon="{ui:SymbolIcon ArrowLeft24}"
            Style="{StaticResource IconOnlyButtonStyle}"
            ToolTip="Back" />

          <!--  TODO: Implement `Command="{Binding NavigateForwardCommand}"`  -->
          <ui:Button
            CornerRadius="0,4,4,0"
            Icon="{ui:SymbolIcon ArrowRight24}"
            Style="{StaticResource IconOnlyButtonStyle}"
            ToolTip="Forward" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ui:Button
            Margin="0,0,8,0"
            Command="{Binding NavigateToWorkExperienceTrashCommand}"
            Content="Trash"
            Icon="{ui:SymbolIcon Delete24}"
            ToolTip="View deleted work experiences" />

          <ui:Button
            Appearance="Primary"
            Command="{Binding AddWorkExperienceCommand}"
            Content="Add Work Experience"
            Icon="{ui:SymbolIcon Add24}" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <!--  Row 1: Card - list + optional detail panel  -->
    <Grid
      Grid.Row="1"
      layout:WidthBreakpointBehavior.Breakpoint="{StaticResource PreviewOverlayBreakpoint}"
      layout:WidthBreakpointBehavior.IsBelowBreakpoint="{Binding IsPreviewOverlayMode, Mode=OneWayToSource}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition>
          <ColumnDefinition.Width>
            <MultiBinding Converter="{converters:PanelColumnWidthConverter}" Mode="TwoWay">
              <Binding Path="IsPreviewInlineVisible" />
              <Binding Mode="TwoWay" Path="PreviewPanelWidth" />
            </MultiBinding>
          </ColumnDefinition.Width>
        </ColumnDefinition>
      </Grid.ColumnDefinitions>

      <!--  List  -->
      <ui:Card
        Grid.Column="0"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid x:Name="listCardGrid">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border
            Grid.Row="0"
            Padding="24,12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ui:TextBox
                Grid.Column="0"
                Width="{Binding ActualWidth, ElementName=listCardGrid, Converter={converters:LinearInterpolationConverter}, ConverterParameter='SourceMin=720;SourceMax=880;TargetMin=160;TargetMax=320'}"
                Padding="8,6"
                PlaceholderText="Search by company or position..."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                  <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
              </ui:TextBox>

              <ui:ProgressRing
                Grid.Column="1"
                Width="20"
                Height="20"
                Margin="8,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsSearching, Converter={converters:BooleanToVisibilityConverter}}" />

              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <!--  Filter: scoping the current view, not an action  -->
                <atoms:AdaptiveContent Breakpoints="0;720;1120" ReferenceWidth="{Binding ActualWidth, ElementName=listCardGrid}">
                  <atoms:AdaptiveContent.Expanded>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Updated" />

                        <molecules:SegmentedButton
                          Appearance="Transparent"
                          ItemsSource="{markup:EnumBindingSource {x:Type queryingBase:RelativeDateRange}}"
                          SelectedAppearance="Secondary"
                          SelectedValue="{Binding SelectedUpdatedRange}">
                          <molecules:SegmentedButton.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Converter={converters:EnumDisplayNameConverter}}" />
                            </DataTemplate>
                          </molecules:SegmentedButton.ItemTemplate>
                        </molecules:SegmentedButton>
                      </StackPanel>
                    </DataTemplate>
                  </atoms:AdaptiveContent.Expanded>

                  <atoms:AdaptiveContent.Medium>
                    <DataTemplate>
                      <ui:DropDownButton
                        MinWidth="136"
                        Padding="8,6"
                        HorizontalContentAlignment="Stretch"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Background="Transparent"
                        Content="{Binding SelectedUpdatedRange, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource UpdatedRangeMenu}"
                        Icon="{ui:SymbolIcon Filter24}"
                        ToolTip="Filter by updated date" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Medium>

                  <atoms:AdaptiveContent.Compact>
                    <DataTemplate>
                      <ui:Button
                        MinWidth="120"
                        Padding="8,6"
                        HorizontalContentAlignment="Left"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Appearance="Transparent"
                        Content="{Binding SelectedUpdatedRange, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource UpdatedRangeMenu}"
                        Icon="{ui:SymbolIcon Filter24}"
                        ToolTip="Filter by updated date" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Compact>
                </atoms:AdaptiveContent>

                <atoms:Divider Margin="12,8" Orientation="Vertical" />

                <!--  Sort field  -->
                <atoms:AdaptiveContent Breakpoints="0;720;1200" ReferenceWidth="{Binding ActualWidth, ElementName=listCardGrid}">
                  <atoms:AdaptiveContent.Expanded>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Sort by" />

                        <ComboBox
                          MinWidth="144"
                          Margin="0,0,8,0"
                          Padding="8,6"
                          Background="Transparent"
                          ItemsSource="{markup:EnumBindingSource {x:Type queryingWorkExperiences:WorkExperienceSortField}}"
                          SelectedItem="{Binding SortField}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Converter={converters:EnumDisplayNameConverter}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </DataTemplate>
                  </atoms:AdaptiveContent.Expanded>

                  <atoms:AdaptiveContent.Medium>
                    <DataTemplate>
                      <ui:DropDownButton
                        MinWidth="160"
                        Margin="0,0,8,0"
                        Padding="8,6"
                        HorizontalContentAlignment="Stretch"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Background="Transparent"
                        Content="{Binding SortField, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource SortFieldMenu}"
                        Icon="{ui:SymbolIcon ArrowSort24}"
                        ToolTip="Sort by field" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Medium>

                  <atoms:AdaptiveContent.Compact>
                    <DataTemplate>
                      <ui:Button
                        MinWidth="144"
                        Margin="0,0,8,0"
                        Padding="8,6"
                        HorizontalContentAlignment="Left"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Appearance="Transparent"
                        Content="{Binding SortField, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource SortFieldMenu}"
                        Icon="{ui:SymbolIcon ArrowSort24}"
                        ToolTip="Sort by field" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Compact>
                </atoms:AdaptiveContent>

                <ui:Button
                  Command="{Binding ToggleSortDirectionCommand}"
                  Icon="{Binding IsSortDescending, Converter={converters:SortDirectionIconConverter}}"
                  Style="{StaticResource IconOnlyButtonStyle}"
                  ToolTip="{Binding SortDirectionTooltip}" />

                <atoms:Divider Margin="12,8" Orientation="Vertical" />

                <!--  Page-level actions. Refresh is always available directly; folds into "More" only when very tight on space.  -->
                <atoms:AdaptiveContent Breakpoints="0;720" ReferenceWidth="{Binding ActualWidth, ElementName=listCardGrid}">
                  <atoms:AdaptiveContent.Medium>
                    <DataTemplate>
                      <ui:Button
                        Command="{Binding RefreshCommand}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        Style="{StaticResource IconOnlyButtonStyle}"
                        ToolTip="Refresh" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Medium>

                  <atoms:AdaptiveContent.Compact>
                    <DataTemplate>
                      <ui:Button
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Icon="{ui:SymbolIcon MoreVertical24}"
                        Style="{StaticResource IconOnlyButtonStyle}"
                        ToolTip="More">
                        <ui:Button.ContextMenu>
                          <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding RefreshCommand}" Header="Refresh">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </ui:Button.ContextMenu>
                      </ui:Button>
                    </DataTemplate>
                  </atoms:AdaptiveContent.Compact>
                </atoms:AdaptiveContent>
              </StackPanel>
            </Grid>
          </Border>

          <!--  Table row hosts BOTH the DataGrid and the floating bulk-action bar  -->
          <Grid Grid.Row="1">
            <Grid.Resources>
              <markup:BindingProxy x:Key="DataGridWidthProxy" Data="{Binding ActualWidth, ElementName=listCardGrid}" />
            </Grid.Resources>

            <!--  Empty state  -->
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding HasWorkExperienceItems, Converter={converters:InverseBooleanToVisibilityConverter}}">
              <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{DynamicResource TextFillColorDisabledBrush}"
                Symbol="Briefcase24" />

              <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Binding EmptyStateTitle}" />

              <TextBlock
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding EmptyStateMessage}" />
            </StackPanel>

            <!--  Table  -->
            <atoms:AdaptiveDataGrid
              x:Name="workExperienceDataGrid"
              Padding="{Binding SelectedCount, Converter={converters:ConditionalBottomInsetConverter}, ConverterParameter='0,0,0,0|72'}"
              layout:DataGridMultiSelectBehavior.AfterSyncCommand="{Binding ToggleSelectionCommand}"
              layout:DataGridMultiSelectBehavior.IsEnabled="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              ItemsSource="{Binding WorkExperienceItems}"
              ReferenceWidth="{Binding Source={StaticResource DataGridWidthProxy}, Path=Data}"
              RowHeight="52"
              RowStyle="{StaticResource SelectableDataGridRowStyle}"
              SelectedItem="{Binding SelectedWorkExperienceItem}"
              SelectionMode="Extended"
              Visibility="{Binding HasWorkExperienceItems, Converter={converters:BooleanToVisibilityConverter}}">
              <atoms:AdaptiveDataGrid.Resources>
                <DataGridTemplateColumn
                  x:Key="DurationColumn"
                  Width="*"
                  Header="Duration">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="{Binding WorkExperience, Converter={converters:WorkExperienceDurationConverter}}" />

                        <Border
                          Margin="8,0,0,0"
                          Padding="6,2"
                          Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                          CornerRadius="4"
                          Visibility="{Binding EndDate, Converter={converters:InverseNullToVisibilityConverter}}">
                          <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                            Text="Current" />
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </atoms:AdaptiveDataGrid.Resources>

              <atoms:AdaptiveDataGrid.Layout>
                <!--  Bulk select checkbox  -->
                <DataGridTemplateColumn Width="Auto">
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <CheckBox
                        Margin="16,0,0,0"
                        Padding="0"
                        layout:DataGridMultiSelectBehavior.SelectAllFor="{Binding ElementName=workExperienceDataGrid}"
                        IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsThreeState="True" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>

                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox
                        Margin="16,0,0,0"
                        Padding="2"
                        Command="{Binding DataContext.ToggleSelectionCommand, ElementName=workExperiencePage}"
                        IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <atoms:AdaptiveColumn Breakpoints="0;960">
                  <atoms:AdaptiveColumn.Compact>
                    <!--  Company + Position  -->
                    <DataGridTemplateColumn Width="*" Header="Company / Position">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding CompanyName}" />

                            <TextBlock
                              FontSize="12"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding PositionTitle}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </atoms:AdaptiveColumn.Compact>

                  <atoms:AdaptiveColumn.Medium>
                    <!--  Company  -->
                    <DataGridTextColumn
                      Width="*"
                      Binding="{Binding CompanyName}"
                      Header="Company" />

                    <!--  Position  -->
                    <DataGridTextColumn
                      Width="*"
                      Binding="{Binding PositionTitle}"
                      Header="Position" />
                  </atoms:AdaptiveColumn.Medium>
                </atoms:AdaptiveColumn>

                <atoms:AdaptiveColumn Breakpoints="0;800;1040">
                  <atoms:AdaptiveColumn.Compact>
                    <!--  Details  -->
                    <DataGridTemplateColumn Width="*" Header="Details">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontSize="12" Text="{Binding WorkExperience, Converter={converters:WorkExperienceDurationConverter}}" />

                              <TextBlock
                                Margin="6,0,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="•" />

                              <TextBlock
                                Margin="6,0,0,0"
                                FontSize="12"
                                Text="{Binding Projects.Count, StringFormat='{}{0} projects'}" />
                            </StackPanel>

                            <TextBlock
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding UpdatedAt, Converter={converters:RelativeDateTimeConverter}}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </atoms:AdaptiveColumn.Compact>

                  <atoms:AdaptiveColumn.Medium>
                    <!--  Duration + "Current" badge  -->
                    <StaticResource ResourceKey="DurationColumn" />

                    <!--  Projects + Last Modified  -->
                    <DataGridTemplateColumn Width="Auto" Header="Projects / Modified">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12" Text="{Binding Projects.Count, StringFormat='{}{0} projects'}" />
                            <TextBlock
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding UpdatedAt, Converter={converters:RelativeDateTimeConverter}}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </atoms:AdaptiveColumn.Medium>

                  <atoms:AdaptiveColumn.Expanded>
                    <!--  Duration + "Current" badge  -->
                    <StaticResource ResourceKey="DurationColumn" />

                    <!--  Projects count  -->
                    <DataGridTemplateColumn Width="Auto" Header="Projects">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock
                            Margin="0,0,16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Projects.Count}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Last Modified  -->
                    <DataGridTextColumn Width="Auto" Header="Last Modified">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding UpdatedAt, Converter={converters:RelativeDateTimeConverter}}" />
                          <Setter Property="ToolTip">
                            <Setter.Value>
                              <ToolTip MaxWidth="{x:Static system:Double.PositiveInfinity}">
                                <TextBlock Text="{Binding UpdatedAt, Converter={converters:FullLocalDateTimeConverter}}" TextWrapping="NoWrap" />
                              </ToolTip>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </atoms:AdaptiveColumn.Expanded>
                </atoms:AdaptiveColumn>

                <!--  Actions  -->
                <atoms:AdaptiveColumn Breakpoints="0;800">
                  <atoms:AdaptiveColumn.Compact>
                    <DataGridTemplateColumn
                      Width="Auto"
                      CellStyle="{StaticResource CenteredDataGridCellStyle}"
                      Header="Actions"
                      HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:Button
                              Margin="0,0,8,0"
                              Command="{Binding DataContext.ViewDetailWorkExperienceCommand, ElementName=workExperiencePage}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource IconOnlyButtonStyle}"
                              ToolTip="View Detail">
                              <ui:SymbolIcon Symbol="Eye24" />
                            </ui:Button>

                            <ui:Button
                              Margin="0,0,8,0"
                              Command="{Binding DataContext.EditWorkExperienceCommand, ElementName=workExperiencePage}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource IconOnlyButtonStyle}"
                              ToolTip="Edit">
                              <ui:SymbolIcon Symbol="Edit24" />
                            </ui:Button>

                            <ui:Button
                              layout:ContextMenuBehavior.OpenOnClick="True"
                              Icon="{ui:SymbolIcon MoreVertical24}"
                              Style="{StaticResource IconOnlyButtonStyle}"
                              ToolTip="More">
                              <ui:Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                  <MenuItem
                                    Command="{Binding Data.DuplicateWorkExperienceCommand, Source={StaticResource ViewModelProxy}}"
                                    CommandParameter="{Binding}"
                                    Header="Duplicate"
                                    Icon="{ui:SymbolIcon SaveCopy24}" />

                                  <Separator />

                                  <MenuItem
                                    Command="{Binding Data.DeleteWorkExperienceCommand, Source={StaticResource ViewModelProxy}}"
                                    CommandParameter="{Binding}"
                                    Foreground="IndianRed"
                                    Header="Delete"
                                    Icon="{ui:SymbolIcon Delete24}" />
                                </ContextMenu>
                              </ui:Button.ContextMenu>
                            </ui:Button>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </atoms:AdaptiveColumn.Compact>

                  <atoms:AdaptiveColumn.Medium>
                    <DataGridTemplateColumn
                      Width="Auto"
                      CellStyle="{StaticResource CenteredDataGridCellStyle}"
                      Header="Actions"
                      HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:Button
                              Margin="0,0,8,0"
                              Command="{Binding DataContext.ViewDetailWorkExperienceCommand, ElementName=workExperiencePage}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource IconOnlyButtonStyle}"
                              ToolTip="View Detail">
                              <ui:SymbolIcon Symbol="Eye24" />
                            </ui:Button>

                            <ui:Button
                              Margin="0,0,8,0"
                              Command="{Binding DataContext.EditWorkExperienceCommand, ElementName=workExperiencePage}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource IconOnlyButtonStyle}"
                              ToolTip="Edit">
                              <ui:SymbolIcon Symbol="Edit24" />
                            </ui:Button>

                            <ui:Button
                              Command="{Binding DataContext.DuplicateWorkExperienceCommand, ElementName=workExperiencePage}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource IconOnlyButtonStyle}"
                              ToolTip="Duplicate">
                              <ui:SymbolIcon Symbol="SaveCopy24" />
                            </ui:Button>

                            <atoms:Divider Margin="12,8" Orientation="Vertical" />

                            <ui:Button
                              Command="{Binding DataContext.DeleteWorkExperienceCommand, ElementName=workExperiencePage}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource IconOnlyButtonStyle}"
                              ToolTip="Delete">
                              <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                            </ui:Button>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </atoms:AdaptiveColumn.Medium>
                </atoms:AdaptiveColumn>
              </atoms:AdaptiveDataGrid.Layout>
            </atoms:AdaptiveDataGrid>

            <!--
              Floating bulk-action bar - only appears once something is checked,
              sits above the DataGrid, doesn't push layout
            -->
            <Border
              MaxWidth="{StaticResource PageMaxWidthForm}"
              Margin="24,8"
              Padding="16,8,12,8"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              layout:ToggleBulkBarAnimation.IsVisible="{Binding HasSelection}"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Effect="{StaticResource FloatingBarShadow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                  Margin="4,0,16,0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button
                    Padding="16,8"
                    Appearance="Transparent"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="Delete"
                    Foreground="IndianRed"
                    Icon="{ui:SymbolIcon Delete24}" />

                  <atoms:Divider Margin="12,8" Orientation="Vertical" />

                  <ui:Button
                    Command="{Binding ClearSelectionCommand}"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTip="Clear selection">
                    <ui:SymbolIcon Symbol="Dismiss24" />
                  </ui:Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!--  Footer  -->
          <Border
            Grid.Row="2"
            Padding="24,8"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{Binding ResultSummary}" />

                <TextBlock
                  Margin="8,0,0,0"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding TotalCount, StringFormat='({0} total)'}"
                  Visibility="{Binding IsFiltering, Converter={converters:BooleanToVisibilityConverter}}" />
              </StackPanel>

              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Show" />

                <ComboBox
                  MinWidth="72"
                  Padding="8,6"
                  Background="Transparent"
                  ItemsSource="{x:Static viewModels:WorkExperienceViewModel.PageSizeOptions}"
                  SelectedItem="{Binding PageSize}" />

                <atoms:Divider Margin="12,8" Orientation="Vertical" />

                <TextBlock
                  MinWidth="72"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{Binding PageIndicator}" />

                <ui:Button
                  Margin="0,0,8,0"
                  Padding="8"
                  Appearance="Transparent"
                  Command="{Binding GoToPreviousPageCommand}"
                  ToolTip="Previous page">
                  <ui:SymbolIcon Symbol="ChevronLeft24" />
                </ui:Button>

                <ui:Button
                  Padding="8"
                  Appearance="Transparent"
                  Command="{Binding GoToNextPageCommand}"
                  ToolTip="Next page">
                  <ui:SymbolIcon Symbol="ChevronRight24" />
                </ui:Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </ui:Card>

      <GridSplitter
        Grid.Column="1"
        Width="8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Cursor="SizeWE"
        ResizeBehavior="PreviousAndNext"
        ShowsPreview="False"
        Visibility="{Binding IsPreviewInlineVisible, Converter={converters:BooleanToVisibilityConverter}}" />

      <!--  Scrim: Only appears in overlay mode; click to close.  -->
      <Border
        Grid.Column="0"
        Grid.ColumnSpan="3"
        Background="{DynamicResource SmokeFillColorDefaultBrush}"
        CornerRadius="4"
        Visibility="{Binding IsPreviewOverlayVisible, Converter={converters:BooleanToVisibilityConverter}}">
        <Border.InputBindings>
          <MouseBinding Command="{Binding ClosePreviewPanelCommand}" MouseAction="LeftClick" />
        </Border.InputBindings>
      </Border>

      <!--  Host: Decide whether the panel is inline (column 2) or floating (overlay).  -->
      <Grid Visibility="{Binding IsPreviewPanelVisible, Converter={converters:BooleanToVisibilityConverter}}">
        <Grid.Style>
          <Style TargetType="Grid">
            <!--  Default: inline, column 2  -->
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="1" />

            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPreviewOverlayMode}" Value="True">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Width" Value="{StaticResource PreviewOverlayWidth}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>

        <ui:Card
          Padding="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch">
          <ui:Card.Style>
            <Style BasedOn="{StaticResource {x:Type ui:Card}}" TargetType="ui:Card">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewOverlayMode}" Value="True">
                  <Setter Property="Effect" Value="{StaticResource FloatingBarShadow}" />
                  <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Card.Style>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Panel header  -->
            <Border
              Grid.Row="0"
              Padding="24,12"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="18"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Details" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <!--  Pin toggle  -->
                  <ui:Button
                    Command="{Binding TogglePreviewPanelPinCommand}"
                    Icon="{Binding IsPreviewPanelPinned, Converter={converters:PinIconConverter}}"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTip="{Binding PinTooltip}"
                    Visibility="{Binding IsPreviewOverlayMode, Converter={converters:InverseBooleanToVisibilityConverter}}" />

                  <ui:Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Command="{Binding ClosePreviewPanelCommand}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTip="Close" />
                </StackPanel>
              </Grid>
            </Border>

            <!--  Empty state: panel is pinned but nothing selected yet  -->
            <StackPanel
              Grid.Row="1"
              Margin="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding PreviewedItem, Converter={converters:InverseNullToVisibilityConverter}}">
              <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="{DynamicResource TextFillColorDisabledBrush}"
                Symbol="DocumentSearch24" />

              <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Select a row to preview its details"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            </StackPanel>

            <!--  Content  -->
            <ScrollViewer
              Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              Visibility="{Binding PreviewedItem, Converter={converters:NullToVisibilityConverter}}">
              <StackPanel Margin="24,16">
                <!--  Company + position  -->
                <TextBlock
                  FontSize="18"
                  FontWeight="SemiBold"
                  Text="{Binding PreviewedItem.CompanyName}"
                  TextWrapping="Wrap" />

                <TextBlock
                  Margin="0,2,0,0"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding PreviewedItem.PositionTitle}"
                  TextWrapping="Wrap" />

                <!--  Duration + current badge  -->
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                  <ui:SymbolIcon
                    Margin="0,0,6,0"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="CalendarLtr24" />
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding PreviewedItem.WorkExperience, Converter={converters:WorkExperienceDurationConverter}}" />

                  <Border
                    Margin="8,0,0,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4"
                    Visibility="{Binding PreviewedItem.EndDate, Converter={converters:InverseNullToVisibilityConverter}}">
                    <TextBlock
                      FontSize="11"
                      Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                      Text="Current" />
                  </Border>
                </StackPanel>

                <atoms:Divider Margin="0,16" />

                <!--  Description  -->
                <TextBlock
                  Margin="0,0,0,8"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Description" />

                <TextBlock
                  FontSize="14"
                  LineHeight="20"
                  Text="{Binding PreviewedItem.Description}"
                  TextWrapping="Wrap"
                  Visibility="{Binding PreviewedItem.Description, Converter={converters:NullToVisibilityConverter}}" />

                <TextBlock
                  FontSize="13"
                  FontStyle="Italic"
                  Foreground="{DynamicResource TextFillColorDisabledBrush}"
                  Text="No description added."
                  Visibility="{Binding PreviewedItem.Description, Converter={converters:InverseNullToVisibilityConverter}}" />

                <atoms:Divider Margin="0,16" />

                <!--  Projects  -->
                <TextBlock
                  Margin="0,0,0,8"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Projects" />

                <TextBlock FontSize="14" Text="{Binding PreviewedItem.Projects.Count, StringFormat='{}{0} linked project(s)'}" />
              </StackPanel>
            </ScrollViewer>

            <Border
              Grid.Row="2"
              Padding="24,12"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Visibility="{Binding PreviewedItem, Converter={converters:NullToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button
                  Grid.Column="0"
                  Padding="16,8"
                  HorizontalAlignment="Stretch"
                  Command="{Binding EditWorkExperienceCommand}"
                  CommandParameter="{Binding PreviewedItem}"
                  Content="Edit"
                  Icon="{ui:SymbolIcon Edit24}" />

                <ui:Button
                  Grid.Column="2"
                  Padding="16,8"
                  HorizontalAlignment="Stretch"
                  Appearance="Transparent"
                  Command="{Binding DuplicateWorkExperienceCommand}"
                  CommandParameter="{Binding PreviewedItem}"
                  Content="Duplicate"
                  Icon="{ui:SymbolIcon Copy24}" />

                <ui:Button
                  Grid.Column="4"
                  Command="{Binding DeleteWorkExperienceCommand}"
                  CommandParameter="{Binding PreviewedItem}"
                  Style="{StaticResource IconOnlyButtonStyle}"
                  ToolTip="Delete">
                  <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                </ui:Button>
              </Grid>
            </Border>
          </Grid>
        </ui:Card>
      </Grid>
    </Grid>

    <!--  Row 2: Stats widget - collapsed by default, doesn't push the card's top position  -->
    <ui:CardExpander
      Grid.Row="2"
      Margin="0,8,0,0"
      Padding="16,12"
      ContentPadding="0"
      CornerRadius="4,4,0,0"
      Icon="{ui:SymbolIcon DataBarVertical24}"
      IsExpanded="False">
      <ui:CardExpander.Header>
        <TextBlock VerticalAlignment="Center" Text="Archive statistics" />
      </ui:CardExpander.Header>

      <ItemsControl
        x:Name="statsItemsControl"
        Margin="0"
        ItemsSource="{Binding Stats}"
        Tag="{Binding ActualWidth, ElementName=statsItemsControl, Converter={converters:LessThanConverter}, ConverterParameter=840}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding ActualWidth, ElementName=statsItemsControl, Converter={converters:LinearInterpolationConverter}, ConverterParameter='SourceMin=640;SourceMax=1440;TargetMin=1;TargetMax=3;Round=true'}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              x:Name="cardBorder"
              Margin="1"
              Padding="16"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <Grid>
                <!--
                  Default layout: vertical (icon at the top,
                  value in the middle, sub-label at the bottom)
                -->
                <Grid x:Name="verticalLayout">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding Label}" />

                    <ui:SymbolIcon
                      Grid.Column="1"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Symbol="{Binding Icon}" />
                  </Grid>

                  <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="{Binding Value}" />

                  <TextBlock
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SubLabel}"
                    TextWrapping="Wrap" />
                </Grid>

                <!--  Compact layout: horizontal, single row, hidden by default.  -->
                <Grid x:Name="horizontalLayout" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="{Binding Icon}" />

                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis" />

                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{Binding Value}" />
                </Grid>
              </Grid>
            </Border>

            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter TargetName="verticalLayout" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="horizontalLayout" Property="Visibility" Value="Visible" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ui:CardExpander>
  </Grid>
</UserControl>
