<UserControl
  x:Class="Quaply.Ui.Views.Pages.ProfilePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">
  <Grid Margin="24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  Top actions  -->
    <StackPanel
      Grid.Row="0"
      Margin="0,0,0,8"
      Orientation="Horizontal">
      <Button
        Padding="8"
        Command="{Binding AddProfileCommand}"
        Content="+ Add Profile" />
      <Button
        Margin="8,0,0,0"
        Padding="8"
        Command="{Binding NavigateToWorkExperienceCommand}"
        Content="Go to Work Experience page" />
    </StackPanel>

    <!--  List  -->
    <ui:Card
      Grid.Row="1"
      Padding="0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
          Grid.Row="0"
          Padding="24,16"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
              VerticalAlignment="Center"
              FontSize="18"
              FontWeight="SemiBold"
              Text="Profile Listings" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button
                Margin="0,0,8,0"
                Padding="8"
                Appearance="Transparent"
                ToolTip="Filter">
                <ui:SymbolIcon Symbol="Filter24" />
              </ui:Button>

              <ui:Button
                Padding="8"
                Appearance="Transparent"
                ToolTip="More">
                <ui:SymbolIcon Symbol="MoreVertical24" />
              </ui:Button>
            </StackPanel>
          </Grid>
        </Border>

        <!--  TODO 1: Finding the way to implement the alternating row  -->
        <!--  TODO 2: Don't change directly in data cell, such as CanUserEditRows  -->
        <!--  Table  -->
        <DataGrid
          Grid.Row="1"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          HeadersVisibility="Column"
          ItemsSource="{Binding Profiles}"
          RowHeight="48"
          SelectionMode="Extended">
          <DataGrid.Columns>
            <!--  TODO: Fixing CheckBox's padding is not equal to the left padding with header and footer  -->
            <!--  Checkbox  -->
            <DataGridTemplateColumn Width="64">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--  Full Name  -->
            <DataGridTextColumn
              Width="180"
              Binding="{Binding FullName}"
              Header="Full Name" />

            <!--  TODO: Considering remove Border, go back to DataGridTextColumn  -->
            <!--  Title  -->
            <DataGridTemplateColumn Width="224" Header="Title">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border
                    Padding="8,2"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock Text="{Binding Title}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--  Email  -->
            <DataGridTextColumn
              Width="224"
              Binding="{Binding Email}"
              Header="Email" />

            <!--  Last Modified  -->
            <DataGridTextColumn
              Width="170"
              Binding="{Binding LastModified}"
              Header="Last Modified" />

            <!--  TODO: Finding the way to center the Actions header  -->
            <!--  Actions  -->
            <DataGridTemplateColumn Width="96" Header="Actions">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                      Margin="0,0,8,0"
                      Padding="8"
                      Appearance="Transparent"
                      Command="{Binding EditCommand}"
                      ToolTip="Edit">
                      <ui:SymbolIcon Symbol="Edit24" />
                    </ui:Button>

                    <ui:Button
                      Padding="8"
                      Appearance="Transparent"
                      Command="{Binding DeleteCommand}"
                      ToolTip="Delete">
                      <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                    </ui:Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!--  Footer  -->
        <Border
          Grid.Row="2"
          Padding="24,8"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Showing 2 of 2 profiles" />

            <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Orientation="Horizontal">
              <TextBlock
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Page 1 of 1" />

              <ui:Button
                Margin="0,0,8,0"
                Padding="8"
                Appearance="Transparent"
                IsEnabled="False">
                <ui:SymbolIcon Symbol="ChevronLeft24" />
              </ui:Button>

              <ui:Button
                Padding="8"
                Appearance="Transparent"
                IsEnabled="False">
                <ui:SymbolIcon Symbol="ChevronRight24" />
              </ui:Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </ui:Card>

    <!--  Bottom actions: Edit / Delete  -->
    <StackPanel
      Grid.Row="2"
      Margin="0,8,0,0"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        Padding="8"
        Command="{Binding EditProfileCommand}"
        Content="Edit" />
      <Button
        Margin="8,0,0,0"
        Padding="8"
        Command="{Binding DeleteProfileCommand}"
        Content="Delete" />
    </StackPanel>
  </Grid>
</UserControl>
