<UserControl
  x:Class="Quaply.Ui.Views.Pages.WorkExperienceTrashPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:atoms="clr-namespace:Quaply.Ui.Views.Atoms"
  xmlns:converters="clr-namespace:Quaply.Ui.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:layout="clr-namespace:Quaply.Ui.AttachedProperties"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:viewModels="clr-namespace:Quaply.Ui.ViewModels"
  x:Name="workExperienceTrashPage"
  d:DataContext="{d:DesignInstance Type=viewModels:WorkExperienceTrashViewModel,
                                   IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">
  <Grid Margin="24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <!--  Navigation and Page Header  -->
      <StackPanel Margin="0,0,0,24">
        <StackPanel
          Grid.Row="0"
          Margin="0,0,0,8"
          HorizontalAlignment="Stretch">
          <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Deleted Work Experiences" />
          <TextBlock
            Margin="0,4,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="View deleted work experiences and restore them to your Resume anytime." />
        </StackPanel>

        <ui:Button
          HorizontalAlignment="Left"
          Command="{Binding BackToWorkExperiencesCommand}"
          Icon="{ui:SymbolIcon ArrowLeft24}"
          Style="{StaticResource IconOnlyButtonStyle}"
          ToolTip="Go Back" />
      </StackPanel>

      <!--
        List toolbar - search (primary, frequent) + Empty Trash
        (de-emphasized, rare, destructive)
      -->
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:TextBox
          Grid.Column="0"
          Margin="0,0,8,0"
          PlaceholderText="Search by company or position..."
          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
          <ui:TextBox.Icon>
            <ui:SymbolIcon Symbol="Search24" />
          </ui:TextBox.Icon>
        </ui:TextBox>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <!--  Filter: scoping the current view, not an action  -->
          <ui:DropDownButton
            Padding="16,8"
            layout:ContextMenuBehavior.OpenOnClick="True"
            Content="Filter"
            Icon="{ui:SymbolIcon Filter24}">
            <ui:DropDownButton.ContextMenu>
              <ContextMenu Placement="Bottom">
                <MenuItem
                  Header="Expiring soon only"
                  IsCheckable="True"
                  IsChecked="{Binding ShowExpiringSoonOnly}" />

                <Separator />

                <MenuItem
                  Header="Deleted: All time"
                  IsCheckable="True"
                  IsChecked="{Binding DeletedRangeIsAll}" />

                <MenuItem
                  Header="Deleted: Last 7 days"
                  IsCheckable="True"
                  IsChecked="{Binding DeletedRangeIsLast7Days}" />

                <MenuItem
                  Header="Deleted: Last 30 days"
                  IsCheckable="True"
                  IsChecked="{Binding DeletedRangeIsLast30Days}" />
              </ContextMenu>
            </ui:DropDownButton.ContextMenu>
          </ui:DropDownButton>

          <atoms:Divider Margin="12,8" Orientation="Vertical" />

          <!--  More: rare, page-level actions — including the destructive one  -->
          <ui:DropDownButton
            Padding="16,8"
            layout:ContextMenuBehavior.OpenOnClick="True"
            Content="More"
            Icon="{ui:SymbolIcon MoreVertical24}"
            ToolTip="More">
            <ui:DropDownButton.ContextMenu>
              <ContextMenu Placement="Bottom">
                <!--  Destructive action: buried behind an extra click on purpose  -->
                <MenuItem
                  Command="{Binding EmptyTrashCommand}"
                  Foreground="IndianRed"
                  Header="Empty Trash"
                  IsEnabled="{Binding HasDeletedItems}">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ui:DropDownButton.ContextMenu>
          </ui:DropDownButton>
        </StackPanel>
      </Grid>
    </StackPanel>

    <!--  Row 1: Card - header now only has the title  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--  List  -->
      <ui:Card
        Grid.Column="0"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border
            Grid.Row="0"
            Padding="24,12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Sort by" />

                <ComboBox
                  Width="160"
                  Margin="0,0,8,0"
                  Padding="8,6"
                  Background="Transparent"
                  ItemsSource="{Binding SortFieldOptions}"
                  SelectedItem="{Binding SortField}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={converters:EnumDisplayNameConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <ui:Button
                  Command="{Binding ToggleSortDirectionCommand}"
                  Icon="{Binding IsSortDescending, Converter={converters:SortDirectionIconConverter}}"
                  Style="{StaticResource IconOnlyButtonStyle}"
                  ToolTip="{Binding SortDirectionTooltip}" />
              </StackPanel>

              <ui:Button
                Grid.Column="1"
                Command="{Binding RefreshCommand}"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Style="{StaticResource IconOnlyButtonStyle}"
                ToolTip="Refresh" />
            </Grid>
          </Border>

          <!--  Table row hosts BOTH the DataGrid and the floating bulk-action bar  -->
          <Grid Grid.Row="1">
            <!--  Empty state  -->
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding HasDeletedItems, Converter={converters:InverseBooleanToVisibilityConverter}}">
              <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{DynamicResource TextFillColorDisabledBrush}"
                Symbol="Delete48" />

              <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Trash is empty" />

              <TextBlock
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Deleted work experiences will show up here." />
            </StackPanel>

            <!--  Table  -->
            <DataGrid
              x:Name="workExperienceTrashDataGrid"
              Padding="{Binding SelectedCount, Converter={converters:ConditionalBottomInsetConverter}, ConverterParameter='0,0,0,0|72'}"
              layout:DataGridMultiSelectBehavior.AfterSyncCommand="{Binding ToggleSelectionCommand}"
              layout:DataGridMultiSelectBehavior.IsEnabled="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              ItemsSource="{Binding DeletedItems}"
              RowHeight="52"
              RowStyle="{StaticResource SelectableDataGridRowStyle}"
              SelectedItem="{Binding SelectedItem}"
              SelectionMode="Extended"
              Visibility="{Binding HasDeletedItems, Converter={converters:BooleanToVisibilityConverter}}">
              <DataGrid.Columns>
                <!--  Bulk select checkbox - actually bound this time  -->
                <DataGridTemplateColumn Width="Auto">
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <CheckBox
                        Margin="16,0,0,0"
                        Padding="0"
                        layout:DataGridMultiSelectBehavior.SelectAllFor="{Binding ElementName=workExperienceTrashDataGrid}"
                        IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsThreeState="True" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>

                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox
                        Margin="16,0,0,0"
                        Padding="2"
                        Command="{Binding DataContext.ToggleSelectionCommand, ElementName=workExperienceTrashPage}"
                        IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Company / Position  -->
                <DataGridTemplateColumn Width="240" Header="Company / Position">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding CompanyName}" />

                        <TextBlock
                          FontSize="12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding PositionTitle}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Deleted On  -->
                <DataGridTextColumn Width="150" Header="Deleted On">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{Binding DeletedAt, Converter={converters:RelativeDateTimeConverter}}" />

                      <Setter Property="ToolTip">
                        <Setter.Value>
                          <ToolTip MaxWidth="{x:Static system:Double.PositiveInfinity}">
                            <TextBlock Text="{Binding DeletedAt, Converter={converters:FullLocalDateTimeConverter}}" TextWrapping="NoWrap" />
                          </ToolTip>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!--  Actions  -->
                <DataGridTemplateColumn
                  Width="Auto"
                  CellStyle="{StaticResource CenteredDataGridCellStyle}"
                  Header="Actions"
                  HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                          Margin="0,0,8,0"
                          Command="{Binding DataContext.ViewDetailWorkExperienceCommand, ElementName=workExperienceTrashPage}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="View Detail">
                          <ui:SymbolIcon Symbol="Eye24" />
                        </ui:Button>

                        <ui:Button
                          Margin="0,0,8,0"
                          Command="{Binding DataContext.RestoreWorkExperienceCommand, ElementName=workExperienceTrashPage}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="Restore">
                          <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </ui:Button>

                        <ui:Button
                          Command="{Binding DataContext.PurgeWorkExperienceCommand, ElementName=workExperienceTrashPage}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="Delete Permanently">
                          <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                        </ui:Button>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <!--
              Floating bulk-action bar - only appears once something is checked,
              sits above the DataGrid, doesn't push layout
            -->
            <Border
              MaxWidth="{StaticResource PageMaxWidthForm}"
              Margin="24,8"
              Padding="16,8,12,8"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              layout:ToggleBulkBarAnimation.IsVisible="{Binding HasSelection}"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Effect="{StaticResource FloatingBarShadow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                  Margin="4,0,16,0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Appearance="Transparent"
                    Command="{Binding RestoreSelectedCommand}"
                    Content="Restore"
                    Icon="{ui:SymbolIcon ArrowUndo24}" />

                  <ui:Button
                    Padding="16,8"
                    Appearance="Transparent"
                    Command="{Binding PurgeSelectedCommand}"
                    Content="Delete Permanently"
                    Foreground="IndianRed"
                    Icon="{ui:SymbolIcon Delete24}" />

                  <atoms:Divider Margin="12,8" Orientation="Vertical" />

                  <ui:Button
                    Command="{Binding ClearSelectionCommand}"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTip="Clear selection">
                    <ui:SymbolIcon Symbol="Dismiss24" />
                  </ui:Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </ui:Card>

      <ui:Card
        Grid.Column="1"
        Width="{Binding PreviewPanelWidth}"
        Margin="8,0,0,0"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Visibility="{Binding IsPreviewPanelOpen, Converter={converters:BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!--  Panel header  -->
          <Border
            Grid.Row="0"
            Padding="24,12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Details" />

              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!--  Pin toggle  -->
                <ui:Button
                  Command="{Binding TogglePreviewPanelPinCommand}"
                  Icon="{Binding IsPreviewPanelPinned, Converter={converters:PinIconConverter}}"
                  Style="{StaticResource IconOnlyButtonStyle}"
                  ToolTip="{Binding PinTooltip}" />

                <ui:Button
                  Grid.Column="2"
                  Margin="8,0,0,0"
                  Command="{Binding ClosePreviewPanelCommand}"
                  Icon="{ui:SymbolIcon Dismiss24}"
                  Style="{StaticResource IconOnlyButtonStyle}"
                  ToolTip="Close" />
              </StackPanel>
            </Grid>
          </Border>

          <!--  Empty state: panel is pinned but nothing selected yet  -->
          <StackPanel
            Grid.Row="1"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding PreviewedItem, Converter={converters:InverseNullToVisibilityConverter}}">
            <ui:SymbolIcon
              HorizontalAlignment="Center"
              FontSize="32"
              Foreground="{DynamicResource TextFillColorDisabledBrush}"
              Symbol="DocumentSearch24" />

            <TextBlock
              Margin="0,8,0,0"
              HorizontalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Select a row to preview its details"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          </StackPanel>

          <!--  Content  -->
          <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding PreviewedItem, Converter={converters:NullToVisibilityConverter}}">
            <StackPanel Margin="24,16">
              <!--  Company + position  -->
              <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{Binding PreviewedItem.CompanyName}"
                TextWrapping="Wrap" />

              <TextBlock
                Margin="0,2,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding PreviewedItem.PositionTitle}"
                TextWrapping="Wrap" />

              <!--  Duration + current badge  -->
              <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:SymbolIcon
                  Margin="0,0,6,0"
                  FontSize="14"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Symbol="CalendarLtr24" />
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="13"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding PreviewedItem.WorkExperience, Converter={converters:WorkExperienceDurationConverter}}" />

                <Border
                  Margin="8,0,0,0"
                  Padding="6,2"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                  CornerRadius="4"
                  Visibility="{Binding PreviewedItem.EndDate, Converter={converters:InverseNullToVisibilityConverter}}">
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                    Text="Current" />
                </Border>
              </StackPanel>

              <atoms:Divider Margin="0,16" />

              <!--  Description  -->
              <TextBlock
                Margin="0,0,0,8"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Description" />

              <TextBlock
                FontSize="14"
                LineHeight="20"
                Text="{Binding PreviewedItem.Description}"
                TextWrapping="Wrap"
                Visibility="{Binding PreviewedItem.Description, Converter={converters:NullToVisibilityConverter}}" />

              <TextBlock
                FontSize="13"
                FontStyle="Italic"
                Foreground="{DynamicResource TextFillColorDisabledBrush}"
                Text="No description added."
                Visibility="{Binding PreviewedItem.Description, Converter={converters:InverseNullToVisibilityConverter}}" />
            </StackPanel>
          </ScrollViewer>

          <Border
            Grid.Row="2"
            Padding="24,12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding PreviewedItem, Converter={converters:NullToVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>

              <ui:Button
                Grid.Column="0"
                Padding="16,8"
                HorizontalAlignment="Stretch"
                Command="{Binding RestoreWorkExperienceCommand}"
                CommandParameter="{Binding PreviewedItem}"
                Content="Restore"
                Icon="{ui:SymbolIcon ArrowUndo24}" />

              <ui:Button
                Grid.Column="2"
                Padding="16,8"
                HorizontalAlignment="Stretch"
                Appearance="Transparent"
                Command="{Binding PurgeWorkExperienceCommand}"
                CommandParameter="{Binding PreviewedItem}"
                Content="Delete"
                Foreground="IndianRed"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="Delete permanently" />
            </Grid>
          </Border>
        </Grid>
      </ui:Card>
    </Grid>
  </Grid>
</UserControl>
