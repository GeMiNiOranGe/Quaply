<UserControl
  x:Class="Quaply.Ui.Views.Pages.WorkExperienceTrashPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:atoms="clr-namespace:Quaply.Ui.Views.Atoms"
  xmlns:converters="clr-namespace:Quaply.Ui.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:layout="clr-namespace:Quaply.Ui.AttachedProperties"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:markup="clr-namespace:Quaply.Ui.MarkupHelpers"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules"
  xmlns:queryingBase="clr-namespace:Quaply.Data.Querying.Base;assembly=Quaply.Data"
  xmlns:queryingWorkExperiences="clr-namespace:Quaply.Data.Querying.WorkExperiences;assembly=Quaply.Data"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:viewModels="clr-namespace:Quaply.Ui.ViewModels"
  x:Name="workExperienceTrashPage"
  d:DataContext="{d:DesignInstance Type=viewModels:WorkExperienceTrashViewModel,
                                   IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Style="{StaticResource FadeInSlideUpPage}"
  mc:Ignorable="d">

  <UserControl.Resources>
    <ContextMenu
      x:Key="DeletedRangeMenu"
      x:Shared="False"
      ItemsSource="{markup:EnumBindingSource {x:Type queryingBase:RelativeDateRange}}"
      Placement="Bottom">
      <ContextMenu.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
          <Setter Property="Command" Value="{Binding DataContext.SetDeletedRangeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

          <Setter Property="CommandParameter" Value="{Binding}" />

          <Setter Property="Header" Value="{Binding Converter={converters:EnumDisplayNameConverter}}" />

          <Setter Property="IsCheckable" Value="True" />

          <Setter Property="IsChecked">
            <Setter.Value>
              <MultiBinding Converter="{converters:EnumEqualityConverter}" Mode="OneWay">
                <Binding Path="DataContext.SelectedDeletedRange" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />

                <Binding />
              </MultiBinding>
            </Setter.Value>
          </Setter>
        </Style>
      </ContextMenu.ItemContainerStyle>
    </ContextMenu>

    <ContextMenu
      x:Key="SortFieldMenu"
      x:Shared="False"
      ItemsSource="{markup:EnumBindingSource {x:Type queryingWorkExperiences:WorkExperienceSortField}}"
      Placement="Bottom">
      <ContextMenu.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
          <Setter Property="Command" Value="{Binding DataContext.SetSortFieldCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

          <Setter Property="CommandParameter" Value="{Binding}" />

          <Setter Property="Header" Value="{Binding Converter={converters:EnumDisplayNameConverter}}" />

          <Setter Property="IsCheckable" Value="True" />

          <Setter Property="IsChecked">
            <Setter.Value>
              <MultiBinding Converter="{converters:EnumEqualityConverter}" Mode="OneWay">
                <Binding Path="DataContext.SortField" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />

                <Binding />
              </MultiBinding>
            </Setter.Value>
          </Setter>
        </Style>
      </ContextMenu.ItemContainerStyle>
    </ContextMenu>
  </UserControl.Resources>

  <Grid MaxWidth="{StaticResource PageMaxWidthTable}" Margin="24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Navigation and Page Header  -->
    <StackPanel Grid.Row="0" Margin="0,0,0,24">
      <StackPanel
        Grid.Row="0"
        Margin="0,0,0,8"
        HorizontalAlignment="Stretch">
        <TextBlock
          FontSize="22"
          FontWeight="SemiBold"
          Text="Deleted Work Experiences" />

        <TextBlock
          Margin="0,4,0,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="View deleted work experiences and restore them to your Resume anytime." />
      </StackPanel>

      <ui:Button
        HorizontalAlignment="Left"
        Command="{Binding BackToWorkExperiencesCommand}"
        Icon="{ui:SymbolIcon ArrowLeft24}"
        Style="{StaticResource IconOnlyButtonStyle}"
        ToolTip="Go Back" />
    </StackPanel>

    <!--  Row 1: Card - header now only has the title  -->
    <Grid
      Grid.Row="1"
      layout:WidthBreakpointBehavior.Breakpoint="{StaticResource PreviewOverlayBreakpoint}"
      layout:WidthBreakpointBehavior.IsBelowBreakpoint="{Binding IsPreviewOverlayMode, Mode=OneWayToSource}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition>
          <ColumnDefinition.Width>
            <MultiBinding Converter="{converters:PanelColumnWidthConverter}" Mode="TwoWay">
              <Binding Path="IsPreviewInlineVisible" />
              <Binding Mode="TwoWay" Path="PreviewPanelWidth" />
            </MultiBinding>
          </ColumnDefinition.Width>
        </ColumnDefinition>
      </Grid.ColumnDefinitions>

      <!--  List  -->
      <ui:Card
        Grid.Column="0"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid x:Name="listCardGrid">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border
            Grid.Row="0"
            Padding="24,12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ui:TextBox
                Grid.Column="0"
                Width="{Binding ActualWidth, ElementName=listCardGrid, Converter={converters:LinearInterpolationConverter}, ConverterParameter='SourceMin=720;SourceMax=880;TargetMin=160;TargetMax=320'}"
                Padding="8,6"
                PlaceholderText="Search by company or position..."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                  <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
              </ui:TextBox>

              <ui:ProgressRing
                Grid.Column="1"
                Width="20"
                Height="20"
                Margin="8,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsSearching, Converter={converters:BooleanToVisibilityConverter}}" />

              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <!--  Filter: scoping the current view, not an action  -->
                <atoms:AdaptiveContent Breakpoints="0;720;1120" ReferenceWidth="{Binding ActualWidth, ElementName=listCardGrid}">
                  <atoms:AdaptiveContent.Expanded>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Deleted" />

                        <molecules:SegmentedButton
                          Appearance="Transparent"
                          ItemsSource="{markup:EnumBindingSource {x:Type queryingBase:RelativeDateRange}}"
                          SelectedAppearance="Secondary"
                          SelectedValue="{Binding SelectedDeletedRange}">
                          <molecules:SegmentedButton.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Converter={converters:EnumDisplayNameConverter}}" />
                            </DataTemplate>
                          </molecules:SegmentedButton.ItemTemplate>
                        </molecules:SegmentedButton>
                      </StackPanel>
                    </DataTemplate>
                  </atoms:AdaptiveContent.Expanded>

                  <atoms:AdaptiveContent.Medium>
                    <DataTemplate>
                      <ui:DropDownButton
                        MinWidth="136"
                        Padding="8,6"
                        HorizontalContentAlignment="Stretch"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Background="Transparent"
                        Content="{Binding SelectedDeletedRange, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource DeletedRangeMenu}"
                        Icon="{ui:SymbolIcon Filter24}"
                        ToolTip="Filter by deleted date" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Medium>

                  <atoms:AdaptiveContent.Compact>
                    <DataTemplate>
                      <ui:Button
                        MinWidth="120"
                        Padding="8,6"
                        HorizontalContentAlignment="Left"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Appearance="Transparent"
                        Content="{Binding SelectedDeletedRange, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource DeletedRangeMenu}"
                        Icon="{ui:SymbolIcon Filter24}"
                        ToolTip="Filter by deleted date" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Compact>
                </atoms:AdaptiveContent>

                <atoms:Divider Margin="12,8" Orientation="Vertical" />

                <!--  Sort field  -->
                <atoms:AdaptiveContent Breakpoints="0;720;1200" ReferenceWidth="{Binding ActualWidth, ElementName=listCardGrid}">
                  <atoms:AdaptiveContent.Expanded>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Sort by" />

                        <ComboBox
                          MinWidth="144"
                          Margin="0,0,8,0"
                          Padding="8,6"
                          Background="Transparent"
                          ItemsSource="{markup:EnumBindingSource {x:Type queryingWorkExperiences:WorkExperienceSortField}}"
                          SelectedItem="{Binding SortField}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Converter={converters:EnumDisplayNameConverter}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </DataTemplate>
                  </atoms:AdaptiveContent.Expanded>

                  <atoms:AdaptiveContent.Medium>
                    <DataTemplate>
                      <ui:DropDownButton
                        MinWidth="160"
                        Margin="0,0,8,0"
                        Padding="8,6"
                        HorizontalContentAlignment="Stretch"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Background="Transparent"
                        Content="{Binding SortField, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource SortFieldMenu}"
                        Icon="{ui:SymbolIcon ArrowSort24}"
                        ToolTip="Sort by field" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Medium>

                  <atoms:AdaptiveContent.Compact>
                    <DataTemplate>
                      <ui:Button
                        MinWidth="144"
                        Margin="0,0,8,0"
                        Padding="8,6"
                        HorizontalContentAlignment="Left"
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Appearance="Transparent"
                        Content="{Binding SortField, Converter={converters:EnumDisplayNameConverter}}"
                        ContextMenu="{StaticResource SortFieldMenu}"
                        Icon="{ui:SymbolIcon ArrowSort24}"
                        ToolTip="Sort by field" />
                    </DataTemplate>
                  </atoms:AdaptiveContent.Compact>
                </atoms:AdaptiveContent>

                <ui:Button
                  Command="{Binding ToggleSortDirectionCommand}"
                  Icon="{Binding IsSortDescending, Converter={converters:SortDirectionIconConverter}}"
                  Style="{StaticResource IconOnlyButtonStyle}"
                  ToolTip="{Binding SortDirectionTooltip}" />

                <atoms:Divider Margin="12,8" Orientation="Vertical" />

                <!--
                  Page-level actions. Two states only ("0;720" = no Expanded).
                  Medium: Refresh is a visible button; More holds the destructive action.
                  Compact: Refresh folds into More.
                  TODO: Future "Reset filters": add one MenuItem to Compact and one button to Medium.
                -->
                <atoms:AdaptiveContent Breakpoints="0;720" ReferenceWidth="{Binding ActualWidth, ElementName=listCardGrid}">
                  <atoms:AdaptiveContent.Medium>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <ui:Button
                          Margin="0,0,8,0"
                          Command="{Binding RefreshCommand}"
                          Icon="{ui:SymbolIcon ArrowClockwise24}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="Refresh" />

                        <ui:Button
                          layout:ContextMenuBehavior.OpenOnClick="True"
                          Icon="{ui:SymbolIcon MoreVertical24}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="More">
                          <ui:Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                              <!--  Destructive action: buried behind an extra click on purpose  -->
                              <MenuItem
                                Command="{Binding EmptyTrashCommand}"
                                Foreground="IndianRed"
                                Header="Empty Trash"
                                IsEnabled="{Binding HasTrashItems}">
                                <MenuItem.Icon>
                                  <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                                </MenuItem.Icon>
                              </MenuItem>
                            </ContextMenu>
                          </ui:Button.ContextMenu>
                        </ui:Button>
                      </StackPanel>
                    </DataTemplate>
                  </atoms:AdaptiveContent.Medium>

                  <atoms:AdaptiveContent.Compact>
                    <DataTemplate>
                      <ui:Button
                        layout:ContextMenuBehavior.OpenOnClick="True"
                        Icon="{ui:SymbolIcon MoreVertical24}"
                        Style="{StaticResource IconOnlyButtonStyle}"
                        ToolTip="More">
                        <ui:Button.ContextMenu>
                          <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding RefreshCommand}" Header="Refresh">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                              </MenuItem.Icon>
                            </MenuItem>

                            <Separator />

                            <!--  Destructive action: last, apart from the safe ones  -->
                            <MenuItem
                              Command="{Binding EmptyTrashCommand}"
                              Foreground="IndianRed"
                              Header="Empty Trash"
                              IsEnabled="{Binding HasTrashItems}">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </ui:Button.ContextMenu>
                      </ui:Button>
                    </DataTemplate>
                  </atoms:AdaptiveContent.Compact>
                </atoms:AdaptiveContent>
              </StackPanel>
            </Grid>
          </Border>

          <!--  Table row hosts BOTH the DataGrid and the floating bulk-action bar  -->
          <Grid Grid.Row="1">
            <Grid.Resources>
              <markup:BindingProxy x:Key="DataGridWidthProxy" Data="{Binding ActualWidth, ElementName=listCardGrid}" />
            </Grid.Resources>

            <!--  Empty state  -->
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding HasDeletedItems, Converter={converters:InverseBooleanToVisibilityConverter}}">
              <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{DynamicResource TextFillColorDisabledBrush}"
                Symbol="Delete48" />

              <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Binding EmptyStateTitle}" />

              <TextBlock
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding EmptyStateMessage}" />
            </StackPanel>

            <!--  Table  -->
            <DataGrid
              x:Name="workExperienceTrashDataGrid"
              Padding="{Binding SelectedCount, Converter={converters:ConditionalBottomInsetConverter}, ConverterParameter='0,0,0,0|72'}"
              layout:DataGridMultiSelectBehavior.AfterSyncCommand="{Binding ToggleSelectionCommand}"
              layout:DataGridMultiSelectBehavior.IsEnabled="True"
              layout:DataGridStarColumnRefreshBehavior.RefreshTrigger="{Binding Source={StaticResource DataGridWidthProxy}, Path=Data}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              ItemsSource="{Binding DeletedItems}"
              RowHeight="52"
              RowStyle="{StaticResource SelectableDataGridRowStyle}"
              SelectedItem="{Binding SelectedItem}"
              SelectionMode="Extended"
              Visibility="{Binding HasDeletedItems, Converter={converters:BooleanToVisibilityConverter}}">
              <DataGrid.Columns>
                <!--  Bulk select checkbox - actually bound this time  -->
                <DataGridTemplateColumn Width="Auto">
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <CheckBox
                        Margin="16,0,0,0"
                        Padding="0"
                        layout:DataGridMultiSelectBehavior.SelectAllFor="{Binding ElementName=workExperienceTrashDataGrid}"
                        IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsThreeState="True" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>

                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox
                        Margin="16,0,0,0"
                        Padding="2"
                        Command="{Binding DataContext.ToggleSelectionCommand, ElementName=workExperienceTrashPage}"
                        IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Company / Position  -->
                <DataGridTemplateColumn
                  Width="*"
                  Header="Company / Position"
                  Visibility="{Binding Source={StaticResource DataGridWidthProxy}, Path=Data, Converter={converters:WidthRangeVisibilityConverter}, ConverterParameter='0;880'}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding CompanyName}" />

                        <TextBlock
                          FontSize="12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding PositionTitle}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Company  -->
                <DataGridTextColumn
                  Width="2*"
                  Binding="{Binding CompanyName}"
                  Header="Company"
                  Visibility="{Binding Source={StaticResource DataGridWidthProxy}, Path=Data, Converter={converters:WidthRangeVisibilityConverter}, ConverterParameter='880;'}" />

                <!--  Position  -->
                <DataGridTextColumn
                  Width="2*"
                  Binding="{Binding PositionTitle}"
                  Header="Position"
                  Visibility="{Binding Source={StaticResource DataGridWidthProxy}, Path=Data, Converter={converters:WidthRangeVisibilityConverter}, ConverterParameter='880;'}" />

                <!--  Deleted On  -->
                <DataGridTextColumn Width="*" Header="Deleted On">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{Binding DeletedAt, Converter={converters:RelativeDateTimeConverter}}" />

                      <Setter Property="ToolTip">
                        <Setter.Value>
                          <ToolTip MaxWidth="{x:Static system:Double.PositiveInfinity}">
                            <TextBlock Text="{Binding DeletedAt, Converter={converters:FullLocalDateTimeConverter}}" TextWrapping="NoWrap" />
                          </ToolTip>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!--  Actions  -->
                <DataGridTemplateColumn
                  Width="Auto"
                  CellStyle="{StaticResource CenteredDataGridCellStyle}"
                  Header="Actions"
                  HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                          Margin="0,0,8,0"
                          Command="{Binding DataContext.ViewDetailWorkExperienceCommand, ElementName=workExperienceTrashPage}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="View Detail">
                          <ui:SymbolIcon Symbol="Eye24" />
                        </ui:Button>

                        <ui:Button
                          Margin="0,0,8,0"
                          Command="{Binding DataContext.RestoreWorkExperienceCommand, ElementName=workExperienceTrashPage}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="Restore">
                          <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </ui:Button>

                        <ui:Button
                          Command="{Binding DataContext.PurgeWorkExperienceCommand, ElementName=workExperienceTrashPage}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource IconOnlyButtonStyle}"
                          ToolTip="Delete Permanently">
                          <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                        </ui:Button>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <!--
              Floating bulk-action bar - only appears once something is checked,
              sits above the DataGrid, doesn't push layout
            -->
            <Border
              MaxWidth="{StaticResource PageMaxWidthForm}"
              Margin="24,8"
              Padding="16,8,12,8"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              layout:ToggleBulkBarAnimation.IsVisible="{Binding HasSelection}"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Effect="{StaticResource FloatingBarShadow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                  Margin="4,0,16,0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Appearance="Transparent"
                    Command="{Binding RestoreSelectedCommand}"
                    Content="Restore"
                    Icon="{ui:SymbolIcon ArrowUndo24}" />

                  <ui:Button
                    Padding="16,8"
                    Appearance="Transparent"
                    Command="{Binding PurgeSelectedCommand}"
                    Content="Delete Permanently"
                    Foreground="IndianRed"
                    Icon="{ui:SymbolIcon Delete24}" />

                  <atoms:Divider Margin="12,8" Orientation="Vertical" />

                  <ui:Button
                    Command="{Binding ClearSelectionCommand}"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTip="Clear selection">
                    <ui:SymbolIcon Symbol="Dismiss24" />
                  </ui:Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!--  Footer  -->
          <Border
            Grid.Row="2"
            Padding="24,8"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{Binding ResultSummary}" />

                <TextBlock
                  Margin="8,0,0,0"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding TotalDeletedCount, StringFormat='({0} in trash)'}"
                  Visibility="{Binding IsFiltering, Converter={converters:BooleanToVisibilityConverter}}" />
              </StackPanel>

              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Show" />

                <ComboBox
                  MinWidth="72"
                  Padding="8,6"
                  Background="Transparent"
                  ItemsSource="{x:Static viewModels:WorkExperienceTrashViewModel.PageSizeOptions}"
                  SelectedItem="{Binding PageSize}" />

                <atoms:Divider Margin="12,8" Orientation="Vertical" />

                <TextBlock
                  MinWidth="72"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{Binding PageIndicator}" />

                <ui:Button
                  Margin="0,0,8,0"
                  Padding="8"
                  Appearance="Transparent"
                  Command="{Binding GoToPreviousPageCommand}"
                  ToolTip="Previous page">
                  <ui:SymbolIcon Symbol="ChevronLeft24" />
                </ui:Button>

                <ui:Button
                  Padding="8"
                  Appearance="Transparent"
                  Command="{Binding GoToNextPageCommand}"
                  ToolTip="Next page">
                  <ui:SymbolIcon Symbol="ChevronRight24" />
                </ui:Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </ui:Card>

      <GridSplitter
        Grid.Column="1"
        Width="8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Cursor="SizeWE"
        ResizeBehavior="PreviousAndNext"
        ShowsPreview="False"
        Visibility="{Binding IsPreviewInlineVisible, Converter={converters:BooleanToVisibilityConverter}}" />

      <!--  Scrim: Only appears in overlay mode; click to close.  -->
      <Border
        Grid.Column="0"
        Grid.ColumnSpan="3"
        Background="{DynamicResource SmokeFillColorDefaultBrush}"
        CornerRadius="4"
        Visibility="{Binding IsPreviewOverlayVisible, Converter={converters:BooleanToVisibilityConverter}}">
        <Border.InputBindings>
          <MouseBinding Command="{Binding ClosePreviewPanelCommand}" MouseAction="LeftClick" />
        </Border.InputBindings>
      </Border>

      <!--  Host: Decide whether the panel is inline (column 2) or floating (overlay).  -->
      <Grid Visibility="{Binding IsPreviewPanelVisible, Converter={converters:BooleanToVisibilityConverter}}">
        <Grid.Style>
          <Style TargetType="Grid">
            <!--  Default: inline, column 2  -->
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="1" />

            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPreviewOverlayMode}" Value="True">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Width" Value="{StaticResource PreviewOverlayWidth}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>

        <ui:Card
          Padding="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch">
          <ui:Card.Style>
            <Style BasedOn="{StaticResource {x:Type ui:Card}}" TargetType="ui:Card">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewOverlayMode}" Value="True">
                  <Setter Property="Effect" Value="{StaticResource FloatingBarShadow}" />
                  <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Card.Style>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Panel header  -->
            <Border
              Grid.Row="0"
              Padding="24,12"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="18"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Details" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <!--  Pin toggle  -->
                  <ui:Button
                    Command="{Binding TogglePreviewPanelPinCommand}"
                    Icon="{Binding IsPreviewPanelPinned, Converter={converters:PinIconConverter}}"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTip="{Binding PinTooltip}"
                    Visibility="{Binding IsPreviewOverlayMode, Converter={converters:InverseBooleanToVisibilityConverter}}" />

                  <ui:Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Command="{Binding ClosePreviewPanelCommand}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    ToolTip="Close" />
                </StackPanel>
              </Grid>
            </Border>

            <!--  Empty state: panel is pinned but nothing selected yet  -->
            <StackPanel
              Grid.Row="1"
              Margin="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding PreviewedItem, Converter={converters:InverseNullToVisibilityConverter}}">
              <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="{DynamicResource TextFillColorDisabledBrush}"
                Symbol="DocumentSearch24" />

              <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Select a row to preview its details"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            </StackPanel>

            <!--  Content  -->
            <ScrollViewer
              Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              Visibility="{Binding PreviewedItem, Converter={converters:NullToVisibilityConverter}}">
              <StackPanel Margin="24,16">
                <!--  Company + position  -->
                <TextBlock
                  FontSize="18"
                  FontWeight="SemiBold"
                  Text="{Binding PreviewedItem.CompanyName}"
                  TextWrapping="Wrap" />

                <TextBlock
                  Margin="0,2,0,0"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding PreviewedItem.PositionTitle}"
                  TextWrapping="Wrap" />

                <!--  Duration + current badge  -->
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                  <ui:SymbolIcon
                    Margin="0,0,6,0"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="CalendarLtr24" />
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding PreviewedItem.WorkExperience, Converter={converters:WorkExperienceDurationConverter}}" />

                  <Border
                    Margin="8,0,0,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4"
                    Visibility="{Binding PreviewedItem.EndDate, Converter={converters:InverseNullToVisibilityConverter}}">
                    <TextBlock
                      FontSize="11"
                      Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                      Text="Current" />
                  </Border>
                </StackPanel>

                <atoms:Divider Margin="0,16" />

                <!--  Description  -->
                <TextBlock
                  Margin="0,0,0,8"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Description" />

                <TextBlock
                  FontSize="14"
                  LineHeight="20"
                  Text="{Binding PreviewedItem.Description}"
                  TextWrapping="Wrap"
                  Visibility="{Binding PreviewedItem.Description, Converter={converters:NullToVisibilityConverter}}" />

                <TextBlock
                  FontSize="13"
                  FontStyle="Italic"
                  Foreground="{DynamicResource TextFillColorDisabledBrush}"
                  Text="No description added."
                  Visibility="{Binding PreviewedItem.Description, Converter={converters:InverseNullToVisibilityConverter}}" />
              </StackPanel>
            </ScrollViewer>

            <Border
              Grid.Row="2"
              Padding="24,12"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Visibility="{Binding PreviewedItem, Converter={converters:NullToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <ui:Button
                  Grid.Column="0"
                  Padding="16,8"
                  HorizontalAlignment="Stretch"
                  Command="{Binding RestoreWorkExperienceCommand}"
                  CommandParameter="{Binding PreviewedItem}"
                  Content="Restore"
                  Icon="{ui:SymbolIcon ArrowUndo24}" />

                <ui:Button
                  Grid.Column="2"
                  Padding="16,8"
                  HorizontalAlignment="Stretch"
                  Appearance="Transparent"
                  Command="{Binding PurgeWorkExperienceCommand}"
                  CommandParameter="{Binding PreviewedItem}"
                  Content="Delete"
                  Foreground="IndianRed"
                  Icon="{ui:SymbolIcon Delete24}"
                  ToolTip="Delete permanently" />
              </Grid>
            </Border>
          </Grid>
        </ui:Card>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
