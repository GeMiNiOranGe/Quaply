<UserControl
  x:Class="Quaply.Ui.Views.Organisms.PaginationFooter"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:atoms="clr-namespace:Quaply.Ui.Views.Atoms"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui.Views.Organisms"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:molecules="clr-namespace:Quaply.Ui.Views.Molecules"
  x:Name="paginationFooter"
  d:DesignWidth="640"
  mc:Ignorable="d">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <molecules:AnnotatedText
      IsSecondaryTextVisible="{Binding IsSecondaryTextVisible, ElementName=paginationFooter}"
      SecondaryText="{Binding SecondaryText, ElementName=paginationFooter}"
      Text="{Binding Text, ElementName=paginationFooter}" />

    <StackPanel
      Grid.Column="1"
      VerticalAlignment="Center"
      Orientation="Horizontal">
      <molecules:LabeledComboBox
        ItemsSource="{Binding PageSizeOptions, ElementName=paginationFooter}"
        Label="{Binding PageSizeLabel, ElementName=paginationFooter}"
        SelectedItem="{Binding PageSize, ElementName=paginationFooter, Mode=TwoWay}" />

      <atoms:Divider Margin="12,8" Orientation="Vertical" />

      <molecules:Pager
        NextCommand="{Binding NextPageCommand, ElementName=paginationFooter}"
        NextToolTip="{Binding NextPageToolTip, ElementName=paginationFooter}"
        PreviousCommand="{Binding PreviousPageCommand, ElementName=paginationFooter}"
        PreviousToolTip="{Binding PreviousPageToolTip, ElementName=paginationFooter}"
        Text="{Binding PageIndicatorText, ElementName=paginationFooter}" />
    </StackPanel>
  </Grid>
</UserControl>
