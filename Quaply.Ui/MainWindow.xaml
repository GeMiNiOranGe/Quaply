<ui:FluentWindow
  x:Class="Quaply.Ui.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Quaply.Ui"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pages="clr-namespace:Quaply.Ui.Views.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:viewModels="clr-namespace:Quaply.Ui.ViewModels"
  Title="MainWindow"
  Width="1280"
  Height="720"
  MinWidth="960"
  MinHeight="540"
  d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel,
                                   IsDesignTimeCreatable=False}"
  mc:Ignorable="d">
  <DockPanel>
    <ui:TitleBar Title="Quaply" DockPanel.Dock="Top">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="Document16" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:NavigationView
      IsBackButtonVisible="Collapsed"
      OpenPaneLength="256"
      PaneDisplayMode="Left">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem
          Command="{Binding NavigateToProfileCommand}"
          Content="Profile"
          IsActive="{Binding IsProfileSelected}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="ContactCard24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem
          Command="{Binding NavigateToWorkExperienceCommand}"
          Content="Work Experience"
          IsActive="{Binding IsWorkExperienceSelected}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Briefcase24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.ContentOverlay>
        <ContentControl Content="{Binding CurrentViewModel}" />
      </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>
  </DockPanel>
</ui:FluentWindow>
